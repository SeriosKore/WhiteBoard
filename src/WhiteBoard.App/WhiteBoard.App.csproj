<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WhiteBoard.App</RootNamespace>
    <AssemblyName>WhiteBoard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 免环境部署：默认框架依赖便于本地快速迭代；发布时用 publish 加自包含参数 -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhiteBoard.Core\WhiteBoard.Core.csproj" />
    <ProjectReference Include="..\WhiteBoard.Rendering\WhiteBoard.Rendering.csproj" />
  </ItemGroup>

</Project>
